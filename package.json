{
  "name": "trip-manager",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "jest",
    "emulators": "firebase emulators:start",
    "build:dev": "eas build --profile development --platform android"
  },
  "dependencies": {
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "prettier": "^3.9.10"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "private": true
}
