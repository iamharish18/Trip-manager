rules_version = '2';

// Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // 1–max characters, no leading or trailing spaces.
    function validText(value, max) {
      return value is string && value.size() >= 1 && value.size() <= max && value.trim() == value;
    }

    function validName(name) {
      return validText(name, 40);
    }

    function isIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---- Users (SPEC §3.1) ----------------------------------------------

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // Only the name and the notifications switch can change.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'notificationsOff'])
        && validName(request.resource.data.name)
        && request.resource.data.get('notificationsOff', false) is bool;

      allow delete: if false;
    }

    // ---- Trip IDs (SPEC §5) ---------------------------------------------

    // Reserved once, together with the trip that uses it; never changed.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tripId'])
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.creatorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.joinCode == code;
      allow list, update: if false;

      // Removed with its trip, by the creator, once the trip is being deleted.
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.creatorUid == request.auth.uid
        && get(/databases/$(database)/documents/trips/$(resource.data.tripId)).data.get('deleting', false) == true;
    }

    // ---- Trips (SPEC §4, §5) --------------------------------------------

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    function validTripDates(data) {
      return isIsoDate(data.startDate)
        && (data.endDate == null || (isIsoDate(data.endDate) && data.endDate >= data.startDate));
    }

    // Open for changes: Active, or Reopened within 24 hours of reopening
    // (checked against the server's clock, SPEC §9).
    function reopenWindowOpen(trip) {
      return trip.data.status == 'reopened'
        && request.time < trip.data.reopenedAt + duration.value(24, 'h');
    }

    // Nothing can change in a trip that is being deleted (SPEC §13).
    function editable(trip) {
      return (trip.data.status == 'active' || reopenWindowOpen(trip))
        && trip.data.get('deleting', false) == false;
    }

    match /trips/{tripId} {
      // Members read their trips. Anyone signed in who knows an Active
      // trip (i.e. has its Trip ID) can read it, to preview it before
      // joining (SPEC §5). Listing is members-only, so trips can't be browsed.
      allow get: if signedIn()
        && (request.auth.uid in resource.data.memberUids || resource.data.status == 'active');
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Created in one transaction with its Trip ID and participants.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['name', 'startDate', 'endDate', 'creatorUid', 'memberUids', 'status', 'joinCode', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['name', 'startDate', 'endDate', 'creatorUid', 'memberUids', 'status', 'joinCode', 'createdAt'])
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.status == 'active'
        && validText(request.resource.data.name, 60)
        && validTripDates(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/joinCodes/$(request.resource.data.joinCode)).data.tripId == tripId;

      // Only the creator edits the name and dates, while the trip is open.
      function editsDetails() {
        return resource.data.creatorUid == request.auth.uid
          && editable(resource)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'startDate', 'endDate'])
          && validText(request.resource.data.name, 60)
          && validTripDates(request.resource.data);
      }

      // Joining an Active trip: add only yourself to the members.
      function joins() {
        return resource.data.status == 'active'
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid]);
      }

      // Leaving an Active trip: remove only yourself. The creator can't leave.
      function leaves() {
        return resource.data.status == 'active'
          && request.auth.uid in resource.data.memberUids
          && request.auth.uid != resource.data.creatorUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid]);
      }

      // Closing (creator): Active → Closed, or Reopened → Final.
      function closes() {
        return resource.data.creatorUid == request.auth.uid
          && (
            (resource.data.status == 'active' && request.resource.data.status == 'closed')
            || (resource.data.status == 'reopened' && request.resource.data.status == 'final')
          )
          && request.resource.data.closedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt']);
      }

      // Reopening (creator, once): Closed → Reopened for 24 hours.
      function reopens() {
        return resource.data.creatorUid == request.auth.uid
          && resource.data.status == 'closed'
          && resource.data.get('reopenUsed', false) == false
          && request.resource.data.status == 'reopened'
          && request.resource.data.reopenUsed == true
          && request.resource.data.reopenedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopenUsed', 'reopenedAt']);
      }

      // Finalising (any member) once the 24-hour reopen window has passed.
      function finalisesAfterWindow() {
        return request.auth.uid in resource.data.memberUids
          && resource.data.status == 'reopened'
          && !reopenWindowOpen(resource)
          && request.resource.data.status == 'final'
          && request.resource.data.closedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedAt']);
      }

      // Deleting (creator, SPEC §13), step 1: mark the trip as being deleted.
      function marksDeleting() {
        return resource.data.creatorUid == request.auth.uid
          && request.resource.data.deleting == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleting']);
      }

      allow update: if signedIn()
        && (editsDetails() || joins() || leaves() || closes() || reopens() || finalisesAfterWindow()
            || marksDeleting());

      // Step 3: the trip itself, once its contents are gone.
      allow delete: if signedIn()
        && resource.data.creatorUid == request.auth.uid
        && resource.data.get('deleting', false) == true;

      function trip() {
        return get(tripPath(tripId));
      }

      function tripAfter() {
        return getAfter(tripPath(tripId));
      }

      function isMember() {
        return signedIn() && request.auth.uid in trip().data.memberUids;
      }

      // Step 2 of deleting: the creator may remove anything inside a trip
      // that is marked as being deleted.
      function creatorDeletingTrip() {
        return signedIn()
          && trip().data.creatorUid == request.auth.uid
          && trip().data.get('deleting', false) == true;
      }

      // ---- Participants (SPEC §5) ----

      // You're joining in this same write: not a member before, and the
      // trip's members afterwards are the old ones plus you.
      function joiningNow() {
        return trip().data.status == 'active'
          && !(request.auth.uid in trip().data.memberUids)
          && tripAfter().data.memberUids == trip().data.memberUids.concat([request.auth.uid]);
      }

      match /participants/{pid} {
        // Members, and anyone previewing an Active trip before joining.
        allow read: if isMember() || (signedIn() && trip().data.status == 'active');

        function validNewParticipant() {
          return request.resource.data.keys().hasOnly(['name', 'claimedByUid', 'addedAt'])
            && request.resource.data.keys().hasAll(['name', 'claimedByUid', 'addedAt'])
            && validName(request.resource.data.name)
            && request.resource.data.addedAt == request.time;
        }

        // The creator adds people while the trip is open; only during trip
        // creation may they add one claimed by themself. Someone joining may
        // add themself (claimed by them) if their name isn't on the list.
        allow create: if signedIn()
          && validNewParticipant()
          && (
            (tripAfter().data.creatorUid == request.auth.uid
              && editable(tripAfter())
              && (request.resource.data.claimedByUid == null
                  || (request.resource.data.claimedByUid == request.auth.uid && !exists(tripPath(tripId)))))
            || (request.resource.data.claimedByUid == request.auth.uid && joiningNow())
          );

        // The creator renames anyone, including themself.
        function renames() {
          return trip().data.creatorUid == request.auth.uid
            && editable(trip())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
            && validName(request.resource.data.name);
        }

        // Claiming an unclaimed name while joining.
        function claims() {
          return resource.data.claimedByUid == null
            && request.resource.data.claimedByUid == request.auth.uid
            && request.resource.data.get('leftAt', null) == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedByUid', 'leftAt'])
            && joiningNow();
        }

        // Releasing your own name while leaving (not the creator).
        function releases() {
          return resource.data.claimedByUid == request.auth.uid
            && request.auth.uid != trip().data.creatorUid
            && trip().data.status == 'active'
            && request.resource.data.claimedByUid == null
            && request.resource.data.leftAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedByUid', 'leftAt'])
            && !(request.auth.uid in tripAfter().data.memberUids);
        }

        allow update: if signedIn() && (renames() || claims() || releases());

        // The creator removes people who haven't claimed their spot.
        // (The app also blocks removing anyone who is in an expense.)
        allow delete: if (signedIn()
          && trip().data.creatorUid == request.auth.uid
          && editable(trip())
          && resource.data.claimedByUid == null)
          || creatorDeletingTrip();
      }

      // ---- Custom categories (SPEC §7) ----

      match /categories/{cid} {
        allow read: if isMember();

        // Default IDs are reserved; names are checked for clashes in the app.
        allow create: if isMember()
          && editable(trip())
          && !(cid in ['food', 'stay', 'travel', 'activities', 'shopping', 'other'])
          && request.resource.data.keys().hasOnly(['name', 'createdByUid', 'createdAt'])
          && request.resource.data.keys().hasAll(['name', 'createdByUid', 'createdAt'])
          && validText(request.resource.data.name, 20)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // The app only deletes categories that no expense uses.
        allow delete: if (isMember() && editable(trip())) || creatorDeletingTrip();

        allow update: if false;
      }

      // ---- Expenses (SPEC §6) ----

      function validCategory(categoryId) {
        return categoryId is string
          && (categoryId in ['food', 'stay', 'travel', 'activities', 'shopping', 'other']
              || exists(/databases/$(database)/documents/trips/$(tripId)/categories/$(categoryId)));
      }

      function validExpense(data) {
        return data.amount is int
          && data.amount >= 1
          && data.amount <= 1000000
          && data.paidByPid is string
          && data.paidByPid in data.splitAmongPids
          && validCategory(data.categoryId)
          && isIsoDate(data.date)
          && data.description is string
          && data.description.size() <= 100
          && data.description.trim() == data.description
          && data.isDeleted is bool;
      }

      match /expenses/{eid} {
        allow read: if isMember();

        allow create: if isMember()
          && editable(trip())
          && request.resource.data.keys().hasOnly(
               ['amount', 'paidByPid', 'categoryId', 'date', 'description', 'splitAmongPids',
                'createdByUid', 'createdAt', 'updatedAt', 'isDeleted', 'notifyPending'])
          && request.resource.data.keys().hasAll(
               ['amount', 'paidByPid', 'categoryId', 'date', 'description', 'splitAmongPids',
                'createdByUid', 'createdAt', 'updatedAt', 'isDeleted', 'notifyPending'])
          && request.resource.data.notifyPending == true
          && validExpense(request.resource.data)
          && request.resource.data.splitAmongPids is list
          && request.resource.data.splitAmongPids.size() >= 1
          && request.resource.data.splitAmongPids.size() <= 20
          && exists(/databases/$(database)/documents/trips/$(tripId)/participants/$(request.resource.data.paidByPid))
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.isDeleted == false;

        // The split list, creator and creation time never change.
        function edits() {
          return editable(trip())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['amount', 'paidByPid', 'categoryId', 'date', 'description', 'updatedAt', 'isDeleted'])
            && validExpense(request.resource.data)
            && request.resource.data.updatedAt == request.time;
        }

        // The person who added it marks its notification as sent (SPEC §11).
        function marksNotified() {
          return resource.data.createdByUid == request.auth.uid
            && resource.data.get('notifyPending', false) == true
            && request.resource.data.notifyPending == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifyPending']);
        }

        allow update: if isMember() && (edits() || marksNotified());

        // Deleting is a soft delete (isDeleted); real deletes only happen
        // when the creator deletes the whole trip.
        allow delete: if creatorDeletingTrip();
      }

      // ---- Settlements (SPEC §9) ----

      function isLocked(trip) {
        return trip.data.status in ['closed', 'final'];
      }

      // This write closes the trip (Active → Closed or Reopened → Final).
      function closingNow() {
        return !isLocked(trip()) && isLocked(tripAfter());
      }

      // Shortly after a close, settlements of that close may be recalculated
      // (the closer's double-check), as long as none is marked paid.
      function justClosed() {
        return isLocked(trip()) && request.time < trip().data.closedAt + duration.value(5, 'm');
      }

      // This write reopens the trip (Closed → Reopened).
      function reopeningNow() {
        return trip().data.status == 'closed' && tripAfter().data.status == 'reopened';
      }

      function claimedBy(pid) {
        return get(/databases/$(database)/documents/trips/$(tripId)/participants/$(pid)).data.claimedByUid;
      }

      match /settlements/{sid} {
        allow read: if isMember();

        allow create: if isMember()
          && (closingNow() || justClosed())
          && request.resource.data.keys().hasOnly(
               ['fromPid', 'toPid', 'amount', 'round', 'isPaid', 'isRecordedPayment', 'markedByUid', 'markedAt', 'createdAt'])
          && request.resource.data.keys().hasAll(
               ['fromPid', 'toPid', 'amount', 'round', 'isPaid', 'isRecordedPayment', 'markedByUid', 'markedAt', 'createdAt'])
          && request.resource.data.fromPid is string
          && request.resource.data.toPid is string
          && request.resource.data.fromPid != request.resource.data.toPid
          && request.resource.data.amount is int
          && request.resource.data.amount >= 1
          && request.resource.data.round == (tripAfter().data.status == 'closed' ? 1 : 2)
          && request.resource.data.isPaid == false
          && request.resource.data.isRecordedPayment == false
          && request.resource.data.markedByUid == null
          && request.resource.data.markedAt == null
          && request.resource.data.createdAt == request.time;

        // Mark paid / not paid: the payer, the receiver, or the creator,
        // while the trip is closed. Earlier (recorded) payments are fixed.
        function marksPaid() {
          return isLocked(trip())
            && resource.data.isRecordedPayment == false
            && request.resource.data.isPaid is bool
            && request.resource.data.markedByUid == request.auth.uid
            && request.resource.data.markedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPaid', 'markedByUid', 'markedAt'])
            && (request.auth.uid == trip().data.creatorUid
                || claimedBy(resource.data.fromPid) == request.auth.uid
                || claimedBy(resource.data.toPid) == request.auth.uid);
        }

        // On reopen, payments marked paid are kept as recorded payments.
        function recordsOnReopen() {
          return reopeningNow()
            && trip().data.creatorUid == request.auth.uid
            && resource.data.isPaid == true
            && request.resource.data.isRecordedPayment == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRecordedPayment']);
        }

        allow update: if isMember() && (marksPaid() || recordsOnReopen());

        // Unpaid settlements are discarded on reopen, or replaced by the
        // closer's double-check right after a close.
        allow delete: if (isMember()
          && resource.data.isPaid == false
          && resource.data.isRecordedPayment == false
          && ((reopeningNow() && trip().data.creatorUid == request.auth.uid) || justClosed()))
          || creatorDeletingTrip();
      }

      // ---- Push addresses (SPEC §11) ----

      // One per member, so members can notify each other. You write only
      // your own; you can always remove your own (e.g. when leaving).
      match /pushTokens/{uid} {
        allow read: if isMember();
        allow create, update: if isMember()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.keys().hasAll(['token', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 200
          && request.resource.data.updatedAt == request.time;
        allow delete: if (signedIn() && request.auth.uid == uid) || creatorDeletingTrip();
      }

      // ---- Comments (SPEC §10) ----

      match /comments/{cid} {
        allow read: if isMember();

        // Members post as themselves (their own spot on the trip) on an
        // existing expense, while the trip is open. Up to 300 characters.
        allow create: if isMember()
          && editable(trip())
          && request.resource.data.keys().hasOnly(['expenseId', 'text', 'authorUid', 'authorPid', 'createdAt'])
          && request.resource.data.keys().hasAll(['expenseId', 'text', 'authorUid', 'authorPid', 'createdAt'])
          && request.resource.data.authorUid == request.auth.uid
          && get(/databases/$(database)/documents/trips/$(tripId)/participants/$(request.resource.data.authorPid)).data.claimedByUid == request.auth.uid
          && exists(/databases/$(database)/documents/trips/$(tripId)/expenses/$(request.resource.data.expenseId))
          && validText(request.resource.data.text, 300)
          && request.resource.data.createdAt == request.time;

        // Comments can't be edited; only the author deletes, while open.
        allow update: if false;
        allow delete: if (isMember()
          && editable(trip())
          && resource.data.authorUid == request.auth.uid)
          || creatorDeletingTrip();
      }
    }
  }
}
